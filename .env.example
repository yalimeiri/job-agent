# Copy to .env and fill in. .env is gitignored — never commit real values.
# For local `go run` testing the test commands load these automatically.

# Postgres (docker compose creates this DB; localhost DSN for local runs)
DATABASE_URL=postgres://jobagent:jobagent@localhost:5432/jobagent?sslmode=disable

# JSearch via RapidAPI — https://rapidapi.com/letscrape-6bRBa3QguO5/api/jsearch
RAPIDAPI_KEY=

# Matcher API key. Default provider is Groq (free, no card): https://console.groq.com/keys
GROQ_API_KEY=
# If you switch matching.provider to "anthropic", set this instead:
# ANTHROPIC_API_KEY=

# Telegram bot — create via @BotFather, get chat id via @userinfobot
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
